# Configuration for the CSMS integration tests, see README.md.
# Copy to .env and adjust. All values below are the defaults for a local
# evtivity started with docker compose, an empty .env works there.

# evtivity REST API and OCPP endpoints
EVTIVITY_API=http://localhost:7102
EVTIVITY_WS=ws://localhost:7103
EVTIVITY_WSS=wss://localhost:8443

# Dashboard admin login used for the REST API
EVTIVITY_ADMIN_EMAIL=admin@evtivity.local
EVTIVITY_ADMIN_PASSWORD=admin123

# Docker container names, used to extract the TLS test certificates, to
# register the mTLS client certificate and for the offline test
EVTIVITY_DOCKER_OCPP=evtivity-ocpp-1
EVTIVITY_DOCKER_PG=evtivity-postgres-1

# TLS test certificates. If unset they are extracted from the ocpp container.
#EVTIVITY_CA_FILE=
#EVTIVITY_CLIENT_CERT=
#EVTIVITY_CLIENT_KEY=

# RFID tokens known to the CSMS (evtivity demo seed). Comma separated, each
# test uses its own token because the CSMS tracks payment state per driver.
RFID_TOKENS=RFID-000001,RFID-000002,RFID-000003,RFID-000004,RFID-000005,RFID-000006,RFID-000007,RFID-000008,RFID-000009,RFID-000010

# Path to the tfocpp checkout with built host binaries (default: repo root)
#TFOCPP_DIR=
